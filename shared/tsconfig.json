{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "strictPropertyInitialization": false,
    "pretty": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    /* TS 7 ne charge plus implicitement tous les @types. */
    "types": [
      "node"
    ],
    "target": "ES2022",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "jsx": "react",
    "noErrorTruncation": true,
    "noUncheckedSideEffectImports": true
  },
  "references": [
    {
      "path": "../sdk"
    }
  ],
  "include": [
    "./src/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": [
      "@types/node"
    ]
  }
}

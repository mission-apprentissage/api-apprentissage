{
  "variable": {
    "PRODUCT_NAME": {},
    "REPO_NAME": {},
    "VERSION": {},
    "CHANNEL": {},
    "DEPS_ID": {}
  },
  "group": {
    "production": {
      "targets": [
        "server",
        "ui-production"
      ]
    },
    "recette": {
      "targets": [
        "server",
        "ui-recette"
      ]
    },
    "preview": {
      "targets": [
        "server",
        "ui-preview"
      ]
    },
    "local": {
      "targets": [
        "server",
        "ui-local"
      ]
    }
  },
  "target": {
    "common": {
      "args": {
        "PUBLIC_VERSION": "${VERSION}",
        "PUBLIC_PRODUCT_NAME": "${PRODUCT_NAME}",
        "PUBLIC_REPO_NAME": "${REPO_NAME}"
      },
      "dockerfile": "Dockerfile",
      "platforms": [
        "linux/amd64"
      ],
      "labels": {
        "org.opencontainers.image.source": "https://github.com/mission-apprentissage/${REPO_NAME}",
        "org.opencontainers.image.licenses": "MIT"
      }
    },
    "server": {
      "inherits": [
        "common"
      ],
      "cache-from": [
        "type=gha,scope=server-${DEPS_ID}"
      ],
      "cache-to": [
        "type=gha,mode=max,scope=server-${DEPS_ID}"
      ],
      "tags": [
        "ghcr.io/mission-apprentissage/mna_${PRODUCT_NAME}_server:${VERSION}",
        "ghcr.io/mission-apprentissage/mna_${PRODUCT_NAME}_server:${CHANNEL}"
      ],
      "labels": {
        "org.opencontainers.image.description": "Server"
      },
      "target": "server"
    },
    "ui": {
      "inherits": [
        "common"
      ],
      "matrix": {
        "ENV": [
          "production",
          "recette",
          "preview",
          "local"
        ]
      },
      "name": "ui-${ENV}",
      "cache-from": [
        "type=gha,scope=server-${DEPS_ID}",
        "type=gha,scope=ui-${ENV}-${DEPS_ID}"
      ],
      "cache-to": [
        "type=gha,mode=max,scope=ui-${ENV}-${DEPS_ID}"
      ],
      "args": {
        "PUBLIC_ENV": "${ENV}"
      },
      "tags": [
        "ghcr.io/mission-apprentissage/mna_${PRODUCT_NAME}_ui:${VERSION}-${ENV}",
        "ghcr.io/mission-apprentissage/mna_${PRODUCT_NAME}_ui:${CHANNEL}-${ENV}"
      ],
      "labels": {
        "org.opencontainers.image.description": "Ui"
      },
      "target": "ui"
    }
  }
}
